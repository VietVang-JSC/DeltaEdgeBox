APP_NAME="DeltaPOS Edge Box"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

# Edge Box Configuration
DEPLOYMENT_MODE=offline-first
STORE_ID=STORE_001
API_KEY=
CLOUD_API_URL=https://api.deltapos.cloud

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Backblaze B2 Configuration (for database backup)
# Get these from: https://secure.backblaze.com/app_keys.htm
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=deltapos-edgebox-backups
B2_REGION=us-west-004
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
